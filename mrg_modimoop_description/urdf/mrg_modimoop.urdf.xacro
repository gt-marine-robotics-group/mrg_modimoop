<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema" name="MODIMOOP">
  <xacro:arg name="model_name" default="none_mrg_modimoop"/>
  <xacro:arg name="keel_cp" default="-0.633 0 -0.351"/>
  <link name="hull_link">
    <inertial>
      <origin xyz="-0.633 0 -0.351" rpy="0 0 0"/>
      <mass value="22.44"/>
      <inertia ixx="1.96" ixy="0" ixz="-0.529" iyy="2.85" iyz="-0.001" izz="0.99"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/hull_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <!-- Do not use the hull_hydro_100 mesh, it gives poor results. Generally, 200+ gives good hydrodynamic results but slow downs happen quickly -->
    <collision name="hull_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/hull_hydro_200.STL"/>
      </geometry>
    </collision>    
    <!-- Consider using this collision where perfect accuracy is fine initially (i.e. training models or something) -->
    <!--
    <collision name="hull_hydro_collision">
      <origin xyz="0.0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/hull_wedge_box.STL"/>
      </geometry>
    </collision>
    <collision name="keel_plate_collision">
      <origin xyz="-0.575 0 -0.46" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.0125 0.48"/>
      </geometry>
    </collision>
    <collision name="keel_ballast_collision">
      <origin xyz="-0.6 0 -0.65" rpy="0 0 0"/>
      <geometry>
        <box size="0.325 0.09 0.09"/>
      </geometry>
    </collision>
    -->
  </link>
  <link name="wingsail_link">
    <inertial>
      <origin xyz="0 0 0.559" rpy="0 0 0"/>
      <mass value="4.181"/>
      <inertia ixx="0.441" ixy="0" ixz="-0.029" iyy="0.668" iyz="0" izz="0.23"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/wingsail_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision name="wingsail_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/wingsail_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="wingsail_joint" type="continuous">
    <origin xyz="-0.55 0 0" rpy="0 0 0"/>
    <parent link="hull_link"/>
    <child link="wingsail_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="tailwing_link">
    <inertial>
      <origin xyz="-0.017 0 -0.016" rpy="0 0 0"/>
      <mass value="0.201"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/tailwing_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision name="tailwing_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/tailwing_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="tailwing_joint" type="revolute">
    <origin xyz="-0.7485 0 0.73529" rpy="0 0 0"/>
    <parent link="wingsail_link"/>
    <child link="tailwing_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.785" upper="0.785" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="rudder_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.34"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/rudder_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision name="rudder_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mrg_modimoop_description/models/meshes/rudder_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="rudder_joint" type="revolute">
    <origin xyz="-0.850348439870171 0 -0.25961" rpy="0 0 0"/>
    <parent link="hull_link"/>
    <child link="rudder_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>
  <link name="imu_link"/>
  <joint name="imu_mount" type="fixed">
    <parent link="hull_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.675 -0.005 -0.2" rpy="0 0 0"/>
  </joint>
  <link name="gps_link"/>
  <joint name="gps_mount" type="fixed">
    <parent link="hull_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.6 -0.005 0.1" rpy="0 0 0"/>
  </joint>
  <link name="anemometer_link"/>
  <joint name="anemometer_mount" type="fixed">
    <parent link="hull_link"/>
    <child link="anemometer_link"/>
    <origin xyz="-0.6 -0.005 0.35" rpy="0 0 3.141592653589793"/>
  </joint>
  <link name="mag_link"/>
  <joint name="mag_mount" type="fixed">
    <parent link="hull_link"/>
    <child link="mag_link"/>
    <origin xyz="-0.65 -0.005 -0.15" rpy="0 0 0"/>
  </joint>
  <gazebo>
    <plugin name="gz::sim::systems::SailLiftDrag" filename="asv_sim2-sail-lift-drag-system">
      <a0>0.0</a0>
      <cla>6.2832</cla>
      <alpha_stall>0.1592</alpha_stall>
      <cla_stall>-0.7083</cla_stall>
      <cda>0.63662</cda>
      <area>0.396</area>
      <fluid_density>1.225</fluid_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <cp>-0.05 0 0.559</cp>
      <link_name>wingsail_link</link_name>
      <radial_symmetry>1</radial_symmetry>
      <topic>lift_drag</topic>
    </plugin>
    <plugin name="gz::sim::systems::SailLiftDrag" filename="asv_sim2-sail-lift-drag-system">
      <a0>0.0</a0>
      <cla>6.2832</cla>
      <alpha_stall>0.1592</alpha_stall>
      <cla_stall>-0.7083</cla_stall>
      <cda>0.63662</cda>
      <area>0.05</area>
      <fluid_density>1.225</fluid_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <cp>-0.017 0 -0.016</cp>
      <link_name>tailwing_link</link_name>
      <radial_symmetry>1</radial_symmetry>
      <topic>lift_drag</topic>
    </plugin>
    <plugin name="gz::sim::systems::FoilLiftDrag" filename="asv_sim2-foil-lift-drag-system">
      <a0>0.0</a0>
      <cla>6.2832</cla>
      <alpha_stall>0.1592</alpha_stall>
      <cla_stall>-0.7083</cla_stall>
      <cda>0.63662</cda>
      <area>0.17</area>
      <fluid_density>1025</fluid_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <cp>$(arg keel_cp)</cp>
      <link_name>hull_link</link_name>
      <radial_symmetry>1</radial_symmetry>
      <topic>lift_drag</topic>
    </plugin>
    <plugin name="gz::sim::systems::FoilLiftDrag" filename="asv_sim2-foil-lift-drag-system">
      <a0>0.0</a0>
      <cla>5.0</cla>
      <alpha_stall>0.1592</alpha_stall>
      <cla_stall>-0.7083</cla_stall>
      <cda>0.63662</cda>
      <area>0.02322576</area>
      <fluid_density>1025</fluid_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <cp>0 0 0</cp>
      <link_name>rudder_link</link_name>
      <radial_symmetry>1</radial_symmetry>
      <topic>lift_drag</topic>
    </plugin>
    <plugin filename="gz-waves1-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <enable>$(arg model_name)::hull_link</enable>
      <hydrodynamics>
        <damping_on>1</damping_on>
        <viscous_drag_on>1</viscous_drag_on>
        <pressure_drag_on>1</pressure_drag_on>
      </hydrodynamics>
      <markers>
        <update_rate>10</update_rate>
        <water_patch>0</water_patch>
        <waterline>0</waterline>
        <underwater_surface>0</underwater_surface>
      </markers>
    </plugin>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>200</update_rate>
      <visualize>0</visualize>
      <topic>/modimoop/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <pose>0 0 0 0 0 -1.570796327</pose>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
        <orientation>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
          <w>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </w>
        </orientation>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="anemometer_link">
    <sensor name="anemometer" type="custom" gz:type="anemometer">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>anemometer</topic>
      <gz_frame_id>anemometer_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <gz:anemometer>
      </gz:anemometer>
    </sensor>
  </gazebo>
  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>/modimoop/navsat</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <pose>0 0 0 0 0 -1.570796327</pose>
      <visualize>0</visualize>
    </sensor>
  </gazebo>
  <gazebo reference="mag_link">
    <sensor name="mag_sensor" type="magnetometer">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>0</visualize>
      <topic>/modimoop/mag</topic>
      <gz_frame_id>mag_link</gz_frame_id>
      <pose>0 0 0 0 0 -1.570796327</pose>
      <magnetometer/>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wingsail_joint</joint_name>
      <joint_name>rudder_joint</joint_name>
      <joint_name>tailwing_joint</joint_name>
      <topic>/modimoop/joint_state</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>wingsail_joint</joint_name>
      <topic>/modimoop/cmd/wingsail_pos</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_joint</joint_name>
      <topic>/modimoop/cmd/rudder_pos</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tailwing_joint</joint_name>
      <topic>/modimoop/cmd/backwing_pos</topic>
    </plugin>
  </gazebo>
</robot>